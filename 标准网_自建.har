      "headers": [
        {
          "name": "Host",
          "value": "www.biaozhun.org"
        },
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": null
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "请先登录|未登录|登录后",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": null,
    "request": {
      "method": "POST",
      "url": "https://www.biaozhun.org/member/ajax_sign.php",
      "headers": [
        {
          "name": "Host",
          "value": "www.biaozhun.org"
        },
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "Accept",
          "value": "*/*"
        },
        {
          "name": "X-Requested-With",
          "value": "XMLHttpRequest"
        },
        {
          "name": "Referer",
          "value": "https://www.biaozhun.org/member/"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": null
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "签到成功|已签到|明天再来|签到",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "请先登录|未登录|登录后|安全检查",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "msg",
          "re": "(?s)([\\s\\S]+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": null,
    "request": {
      "method": "GET",
      "url": "https://www.biaozhun.org/member/",
      "headers": [
        {
          "name": "Host",
          "value": "www.biaozhun.org"
        },
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": null
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "请先登录|未登录",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "jf",
          "re": "积分:(\\d+)",
          "from": "content"
        },
        {
          "name": "jb",
          "re": "金币[：:](\\d+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": null,
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "cookies": [],
      "data": "html_unescape=false&content=签到结果：{{msg}}｜积分{{jf}}｜金币{{jb}}",
      "mimeType": null
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]