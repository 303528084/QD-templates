[
  {
    "comment": "签到（已签到时 code=1 + Already checked in，仍算通过）",
    "checked": true,
    "request": {
      "method": "POST",
      "url": "https://railgun.info/api/user/checkin",
      "headers": [
        {
          "name": "Host",
          "value": "railgun.info",
          "checked": true
        },
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36",
          "checked": true
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}",
          "checked": true
        },
        {
          "name": "Origin",
          "value": "https://railgun.info",
          "checked": true
        },
        {
          "name": "Referer",
          "value": "https://railgun.info/console",
          "checked": true
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*",
          "checked": true
        },
        {
          "name": "Content-Type",
          "value": "application/json",
          "checked": true
        }
      ],
      "cookies": [],
      "postData": {
        "mimeType": "application/json",
        "text": "{}"
      }
    },
    "success_asserts": [
      {
        "re": "200",
        "from": "status"
      },
      {
        "re": "\"checkedIn\":\\s*true",
        "from": "content"
      }
    ],
    "failed_asserts": [
      {
        "re": "没有权限|Not logged|Unauthorized",
        "from": "content"
      }
    ],
    "extract_variables": [
      {
        "name": "msg",
        "re": "\"message\":\\s*\"([^\"]*)\"",
        "from": "content"
      },
      {
        "name": "today",
        "re": "\"today\":\\s*\"([^\"]*)\"",
        "from": "content"
      }
    ]
  },
  {
    "comment": "读积分与连续签到天数",
    "checked": true,
    "request": {
      "method": "GET",
      "url": "https://railgun.info/api/user/points",
      "headers": [
        {
          "name": "Host",
          "value": "railgun.info",
          "checked": true
        },
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36",
          "checked": true
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}",
          "checked": true
        },
        {
          "name": "Origin",
          "value": "https://railgun.info",
          "checked": true
        },
        {
          "name": "Referer",
          "value": "https://railgun.info/console",
          "checked": true
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*",
          "checked": true
        }
      ],
      "cookies": [],
      "postData": {
        "mimeType": "",
        "text": ""
      }
    },
    "success_asserts": [
      {
        "re": "200",
        "from": "status"
      },
      {
        "re": "\"code\":\\s*0",
        "from": "content"
      }
    ],
    "failed_asserts": [
      {
        "re": "没有权限",
        "from": "content"
      }
    ],
    "extract_variables": [
      {
        "name": "points",
        "re": "\"points\":\\s*\"([0-9]+)",
        "from": "content"
      },
      {
        "name": "streak",
        "re": "\"streak\":\\s*(\\d+)",
        "from": "content"
      }
    ]
  },
  {
    "comment": "日志",
    "checked": true,
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "cookies": [],
      "postData": {
        "mimeType": null,
        "text": "html_unescape=false&content=已签到｜连续{{streak}}天｜积分{{points}}｜{{today}}｜{{msg}}"
      }
    },
    "success_asserts": [
      {
        "re": "200",
        "from": "status"
      },
      {
        "re": "\"状态\": \"200\"",
        "from": "content"
      }
    ],
    "failed_asserts": [],
    "extract_variables": [
      {
        "name": "__log__",
        "re": "\"转换后\": \"(.*)\"",
        "from": "content"
      }
    ]
  }
]