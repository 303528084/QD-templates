[
  {
    "comment": "登录获取 access_token（无验证码，密码由变量传入）",
    "request": {
      "method": "POST",
      "url": "https://2libra.com/api/auth/login",
      "headers": [
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/157.0.0.0 Safari/537.36"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br, zstd"
        },
        {
          "name": "Origin",
          "value": "https://2libra.com"
        },
        {
          "name": "Referer",
          "value": "https://2libra.com/"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "empty"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "cors"
        },
        {
          "name": "Sec-Fetch-Site",
          "value": "same-origin"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "cookies": [],
      "data": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\",\"twoFaCode\":\"\"}",
      "mimeType": "application/json"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "201",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "401",
          "from": "status"
        },
        {
          "re": "密码错误|用户名或密码",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "access_token",
          "re": "(?<=\"access_token\":\")[^\"]+",
          "from": "content"
        },
        {
          "name": "login_m",
          "re": "(?<=\"m\":\")[^\"]*",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "发起签到",
    "request": {
      "method": "POST",
      "url": "https://2libra.com/api/sign",
      "headers": [
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/157.0.0.0 Safari/537.36"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br, zstd"
        },
        {
          "name": "Origin",
          "value": "https://2libra.com"
        },
        {
          "name": "Referer",
          "value": "https://2libra.com/"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "empty"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "cors"
        },
        {
          "name": "Sec-Fetch-Site",
          "value": "same-origin"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Authorization",
          "value": "Bearer {{access_token}}"
        },
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "cookies": [],
      "data": "{}",
      "mimeType": "application/json"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "401",
          "from": "status"
        },
        {
          "re": "Unauthorized",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "sign_ok",
          "re": "(?<=\"ok\":)[^,}]+",
          "from": "content"
        },
        {
          "name": "alreadySigned",
          "re": "(?<=\"alreadySigned\":)[^,}]+",
          "from": "content"
        },
        {
          "name": "sign_coins",
          "re": "(?<=\"coins\":)[^,}]+",
          "from": "content"
        },
        {
          "name": "balance",
          "re": "(?<=\"balance\":)[^,}]+",
          "from": "content"
        },
        {
          "name": "streak",
          "re": "(?<=\"streak\":)[^,}]+",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "核对今日金币流水（确认真的到账）",
    "request": {
      "method": "GET",
      "url": "https://2libra.com/api/coins/today-transaction",
      "headers": [
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/157.0.0.0 Safari/537.36"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br, zstd"
        },
        {
          "name": "Origin",
          "value": "https://2libra.com"
        },
        {
          "name": "Referer",
          "value": "https://2libra.com/"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "empty"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "cors"
        },
        {
          "name": "Sec-Fetch-Site",
          "value": "same-origin"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Authorization",
          "value": "Bearer {{access_token}}"
        }
      ],
      "cookies": [],
      "data": null,
      "mimeType": null
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "401",
          "from": "status"
        },
        {
          "re": "Unauthorized",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "amount",
          "re": "(?<=\"amount\":)[^,}]+",
          "from": "content"
        },
        {
          "name": "reason",
          "re": "(?<=\"reason\":\")[^\"]*",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "输出可读结果",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        }
      ],
      "cookies": [],
      "data": "html_unescape=false&content=2Libra 签到结果｜{% if alreadySigned == 'true' %}今日此前已签，本次未新增金币{% else %}今日签到成功{% endif %}｜本次金币：{{sign_coins}}｜余额：{{balance}}｜连签：{{streak}} 天｜今日流水：{{amount}}",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*?)\"",
          "from": "content"
        }
      ]
    }
  }
]