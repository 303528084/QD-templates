[
  {
    "comment": "访问首页，触发每日登录奖励",
    "request": {
      "method": "GET",
      "url": "http://bbs.vvm2.cc/",
      "headers": [
        {
          "name": "Host",
          "value": "bbs.vvm2.cc"
        },
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "Accept",
          "value": "text/html"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "退出|积分:",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "请先登录|立即登录",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "jf",
          "re": "积分:\\s*(\\d+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "读积分明细，最新一条应是今天的每日登录奖励",
    "request": {
      "method": "GET",
      "url": "http://bbs.vvm2.cc/home.php?mod=spacecp&ac=credit&op=log",
      "headers": [
        {
          "name": "Host",
          "value": "bbs.vvm2.cc"
        },
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "Accept",
          "value": "text/html"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "每天登录",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "请先登录|没有权限",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "d",
          "re": "(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2})",
          "from": "content"
        },
        {
          "name": "gx",
          "re": "贡献\\s*<span[^>]*>\\s*\\+(\\d+)",
          "from": "content"
        },
        {
          "name": "jq",
          "re": "金钱\\s*<span[^>]*>\\s*\\+(\\d+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "写日志",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "cookies": [],
      "data": "html_unescape=false&content=最近登录奖励：{{d}}｜贡献+{{gx}}｜金钱+{{jq}}｜当前积分{{jf}}",
      "mimeType": null
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]