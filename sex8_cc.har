[
  {
    "comment": "签到（已签到时接口返回空串，仍算通过）",
    "request": {
      "method": "POST",
      "url": "https://www.sex8.cc/plugin.php?id=signin%3Asignin_reg",
      "headers": [
        {
          "name": "Host",
          "value": "www.sex8.cc"
        },
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "Accept",
          "value": "*/*"
        },
        {
          "name": "X-Requested-With",
          "value": "XMLHttpRequest"
        },
        {
          "name": "Referer",
          "value": "https://www.sex8.cc/"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        }
      ],
      "cookies": [],
      "data": "ac=regsign",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"is_login\":\\s*1",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "\"is_login\":\\s*0",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "读积分页：银币/金币余额 + 今日签到奖励明细",
    "request": {
      "method": "GET",
      "url": "https://www.sex8.cc/home.php?mod=spacecp&ac=credit",
      "headers": [
        {
          "name": "Host",
          "value": "www.sex8.cc"
        },
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "Referer",
          "value": "https://www.sex8.cc/"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "每日签到奖励",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "请先登录|没有登录",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "yb",
          "re": "银币[：:]\\s*</em>\\s*(\\d+)",
          "from": "content"
        },
        {
          "name": "jb",
          "re": "金币[：:]\\s*</em>\\s*(\\d+)",
          "from": "content"
        },
        {
          "name": "sy",
          "re": "银币 <span[^>]*>\\s*\\+(\\d+)</span>",
          "from": "content"
        },
        {
          "name": "dt",
          "re": "每日签到奖励</td>\\s*<td>([0-9\\-: ]{16})",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "日志",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "cookies": [],
      "data": "html_unescape=false&content=每日签到+{{sy}}银币｜银币{{yb}}｜金币{{jb}}｜{{dt}}",
      "mimeType": null
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]