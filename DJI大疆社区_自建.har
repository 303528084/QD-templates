[
  {
    "comment": null,
    "request": {
      "method": "GET",
      "url": "https://bbs.dji.com/",
      "headers": [
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/95.0.4638.69 Safari/537.36"
        },
        {
          "name": "Referer",
          "value": "https://bbs.dji.com/"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": null,
      "mimeType": null
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "<span>登录</span>",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "formhash",
          "re": "name=\"formhash\" value=\"(.+)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": null,
    "request": {
      "method": "POST",
      "url": "https://bbs.dji.com/api/v2/home/paulsigns/sign?device=desktop",
      "headers": [
        {
          "name": "Origin",
          "value": "https://bbs.dji.com"
        },
        {
          "name": "Referer",
          "value": "https://bbs.dji.com/"
        },
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/95.0.4638.69 Safari/537.36"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"signed\":\\s*true",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "您需要先登录才能继续本操作",
          "from": "content"
        },
        {
          "re": "请先登录|未登录",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "signed",
          "re": "\"signed\":\\s*(\\w+)",
          "from": "content"
        },
        {
          "name": "days",
          "re": "\"days\":\\s*(\\d+)",
          "from": "content"
        },
        {
          "name": "mdays",
          "re": "\"mdays\":\\s*(\\d+)",
          "from": "content"
        },
        {
          "name": "credits",
          "re": "\"credits\":\\s*(\\d+)",
          "from": "content"
        },
        {
          "name": "increased",
          "re": "\"increased\":\\s*(\\d+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "",
    "request": {
      "method": "POST",
      "url": "api://util/urldecode",
      "headers": [],
      "cookies": [],
      "data": "html_unescape=false&content=已签到{{days}}天（本月{{mdays}}天）｜积分{{credits}}",
      "mimeType": null
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]