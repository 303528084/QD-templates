  {
    "comment": "5. 请求打卡（今日已打卡会返回重复提示，属正常）",
    "checked": true,
    "request": {
      "method": "GET",
      "url": "https://club.fnnas.com/plugin.php?id=zqlj_sign&sign={{sign}}",
      "headers": [
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
          "checked": true
        },
        {
          "name": "Referer",
          "value": "https://club.fnnas.com/plugin.php?id=zqlj_sign",
          "checked": true
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9",
          "checked": true
        }
      ],
      "cookies": [],
      "headersSize": -1,
      "bodySize": -1
    },
    "success_asserts": [
      {
        "re": "200",
        "from": "status"
      },
      {
        "re": "(?s)(打卡成功|已经打过卡了|alert_info|获得.{0,10}飞牛币)",
        "from": "content"
      }
    ],
    "failed_asserts": [],
    "extract_variables": [
      {
        "name": "sign_msg",
        "re": "(?s)(打卡成功[^<]{0,40}|您今天已经打过卡了[^<]{0,20})",
        "from": "content"
      }
    ],
    "response": {
      "status": 0,
      "statusText": "",
      "httpVersion": "HTTP/1.1",
      "headers": [],
      "cookies": [],
      "content": {
        "size": 0,
        "mimeType": ""
      },
      "redirectURL": "",
      "headersSize": -1,
      "bodySize": -1
    },
    "cache": {},
