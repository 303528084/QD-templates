[
  {
    "comment": "1. 打开登录页，取 formhash 与 loginhash",
    "checked": true,
    "request": {
      "method": "GET",
      "url": "https://club.fnnas.com/member.php?mod=logging&action=login",
      "headers": [
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
          "checked": true
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
          "checked": true
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9",
          "checked": true
        }
      ],
      "cookies": [],
      "headersSize": -1,
      "bodySize": -1
    },
    "success_asserts": [
      {
        "re": "200",
        "from": "status"
      },
      {
        "re": "mod=logging",
        "from": "content"
      }
    ],
    "failed_asserts": [],
    "extract_variables": [
      {
        "name": "formhash",
        "re": "name=\"formhash\" value=\"([0-9a-zA-Z]+)\"",
        "from": "content"
      },
      {
        "name": "loginhash",
        "re": "loginhash=([0-9a-zA-Z]+)",
        "from": "content"
      }
    ],
    "response": {
      "status": 0,
      "statusText": "",
      "httpVersion": "HTTP/1.1",
      "headers": [],
      "cookies": [],
      "content": {
        "size": 0,
        "mimeType": ""
      },
      "redirectURL": "",
      "headersSize": -1,
      "bodySize": -1
    },
    "cache": {},
    "timings": {
      "send": 0,
      "wait": 0,
      "receive": 0
    }
  },
  {
    "comment": "2. 提交账号密码登录",
    "checked": true,
    "request": {
      "method": "POST",
      "url": "https://club.fnnas.com/member.php?mod=logging&action=login&loginsubmit=yes&loginhash={{loginhash}}&inajax=1",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded",
          "checked": true
        },
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
          "checked": true
        },
        {
          "name": "Referer",
          "value": "https://club.fnnas.com/member.php?mod=logging&action=login",
          "checked": true
        },
        {
          "name": "Origin",
          "value": "https://club.fnnas.com",
          "checked": true
        }
      ],
      "cookies": [],
      "headersSize": -1,
      "bodySize": -1,
      "postData": {
        "mimeType": "application/x-www-form-urlencoded",
        "text": "formhash={{formhash}}&referer=https%3A%2F%2Fclub.fnnas.com%2F&username={{username}}&password={{password}}&questionid=0&answer=&cookietime=2592000"
      }
    },
    "success_asserts": [
      {
        "re": "200",
        "from": "status"
      },
      {
        "re": "succeedhandle|main_succeed",
        "from": "content"
      }
    ],
    "failed_asserts": [
      {
        "re": "密码错误|登录失败|安全提问|验证码|请填写|登录提交失败",
        "from": "content"
      }
    ],
    "extract_variables": [],
    "response": {
      "status": 0,
      "statusText": "",
      "httpVersion": "HTTP/1.1",
      "headers": [],
      "cookies": [],
      "content": {
        "size": 0,
        "mimeType": ""
      },
      "redirectURL": "",
      "headersSize": -1,
      "bodySize": -1
    },
    "cache": {},
    "timings": {
      "send": 0,
      "wait": 0,
      "receive": 0
    }
  },
